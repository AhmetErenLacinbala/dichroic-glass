# GitHub Actions'in GHCR'a yayinladigi imaj (tag eklemeyin).
IMAGE_NAME=ghcr.io/github-kullanici-adi/cam-test
IMAGE_TAG=latest

# Bu alan adinin A/AAAA kaydi Docker sunucusunu gostermeli.
APP_HOST=glass.example.com
ACME_EMAIL=admin@example.com

TRAEFIK_NETWORK=cam-test-proxy
WATCHTOWER_POLL_INTERVAL=300
DOCKER_API_VERSION=1.44
DOCKER_CONFIG_DIR=/root/.docker
TZ=Europe/Istanbul

