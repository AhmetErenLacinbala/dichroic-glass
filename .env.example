# Container image published to GHCR by GitHub Actions (do not include a tag).
IMAGE_NAME=ghcr.io/ahmeterenlacinbala/dichroic-glass
IMAGE_TAG=latest

# This domain's A/AAAA record must point to the Docker server.
APP_HOST=glass.example.com
ACME_EMAIL=admin@example.com

TRAEFIK_NETWORK=cam-test-proxy
WATCHTOWER_POLL_INTERVAL=300
DOCKER_API_VERSION=1.44
DOCKER_CONFIG_DIR=/root/.docker
TZ=Europe/Istanbul
